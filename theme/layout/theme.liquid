<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {%- if page_title -%}{{ page_title }} — {{ shop.name }}{%- else -%}{{ shop.name }}{%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Google Fonts: Cormorant Garamond (body) + Cormorant (headings) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Cormorant:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet">

  <style>
    /* =========================================================
       CSS Variables — override with Shopify theme settings
       ========================================================= */
    :root {
      --color-bg: #000000;
      --color-bg-secondary: #0a0a0a;
      --color-bg-tertiary: #111111;
      --color-text: #ffffff;
      --color-text-secondary: rgba(255,255,255,0.5);
      --color-text-muted: rgba(255,255,255,0.25);
      --color-border: rgba(255,255,255,0.08);
      --color-border-hover: rgba(255,255,255,0.2);
      --color-accent: #ffffff;
      --font-medieval: 'Cormorant Garamond', serif;
      --font-gothic: 'Cormorant', serif;
    }

    /* =========================================================
       Global Reset + Base
       ========================================================= */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      background: var(--color-bg, #000000);
      color: var(--color-text, #ffffff);
      font-family: var(--font-medieval, 'Cormorant Garamond', serif);
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    ::selection {
      background: rgba(255,255,255,0.12);
      color: #fff;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #000; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 0; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }

    img, video { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    button { cursor: pointer; background: none; border: none; font: inherit; color: inherit; }
    input, textarea, select { font-family: inherit; font-weight: inherit; }

    /* Skip link */
    .skip-link {
      position: absolute;
      top: -100%;
      left: 0;
      padding: 0.5rem 1rem;
      background: #fff;
      color: #000;
      font-size: 0.75rem;
      z-index: 9999;
      font-family: var(--font-medieval);
      letter-spacing: 0.15em;
    }
    .skip-link:focus { top: 0; }

    /* =========================================================
       Keyframe Animations
       ========================================================= */

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes breathe {
      0%, 100% { opacity: 0.8; }
      50%       { opacity: 1; }
    }

    @keyframes textGlow {
      0%, 100% {
        text-shadow:
          0 0 10px rgba(255,255,255,0.4),
          0 0 30px rgba(255,255,255,0.2),
          0 2px 20px rgba(0,0,0,0.8);
      }
      50% {
        text-shadow:
          0 0 15px rgba(255,255,255,0.8),
          0 0 40px rgba(255,255,255,0.4),
          0 0 80px rgba(255,255,255,0.2),
          0 2px 20px rgba(0,0,0,0.8);
      }
    }

    @keyframes grain {
      0%,100% { transform: translate(0,0); }
      10%  { transform: translate(-5%,-10%); }
      20%  { transform: translate(-15%,5%); }
      30%  { transform: translate(7%,-25%); }
      40%  { transform: translate(-5%,25%); }
      50%  { transform: translate(-15%,10%); }
      60%  { transform: translate(15%,0%); }
      70%  { transform: translate(0%,15%); }
      80%  { transform: translate(3%,35%); }
      90%  { transform: translate(-10%,10%); }
    }

    @keyframes fogDrift {
      0%   { transform: translateX(-10%); opacity: 0.03; }
      50%  { opacity: 0.06; }
      100% { transform: translateX(10%);  opacity: 0.03; }
    }

    @keyframes flicker {
      0%, 100% { transform: scaleY(1) scaleX(1); opacity: 1; }
      30%  { transform: scaleY(1.08) scaleX(0.92) translateY(-2px); opacity: 0.9; }
      70%  { transform: scaleY(1.1) scaleX(0.9) translateY(-2.5px); opacity: 0.88; }
    }

    @keyframes flameGlow {
      0%, 100% { opacity: 0.3; transform: scale(1); }
      50%  { opacity: 0.5; transform: scale(1.1); }
    }

    @keyframes emberFloat {
      0%   { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
      10%  { opacity: 1; }
      100% { transform: translateY(-100vh) translateX(var(--drift, 20px)) scale(0); opacity: 0; }
    }

    @keyframes candleFlicker {
      0%   { opacity: 0.7; transform: scale(1); }
      33%  { opacity: 1; transform: scale(1.05); }
      66%  { opacity: 0.85; transform: scale(0.98); }
      100% { opacity: 0.9; transform: scale(1.02); }
    }

    @keyframes scaleIn {
      from { transform: scale(0); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }

    /* Film grain overlay */
    .film-grain {
      position: fixed;
      inset: -50%;
      width: 200%;
      height: 200%;
      pointer-events: none;
      z-index: 9998;
      opacity: 0.035;
      animation: grain 0.5s steps(1) infinite;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      background-size: 200px 200px;
    }

    /* Layout */
    .main-content {
      padding-top: 64px;
      min-height: 100vh;
    }

    /* Index page: no header/footer, no padding */
    .template-index .site-header,
    .template-index .site-footer { display: none; }
    .template-index .main-content { padding-top: 0; }

    /* Product page: full-screen, no header/footer */
    .template-product .site-header,
    .template-product .site-footer { display: none; }
    .template-product .main-content { padding-top: 0; }

    /* Settings + Credits: full-screen */
    .template-page-settings .site-header,
    .template-page-settings .site-footer { display: none; }
    .template-page-settings .main-content { padding-top: 0; }
    .template-page-credits .site-header,
    .template-page-credits .site-footer { display: none; }
    .template-page-credits .main-content { padding-top: 0; }

    /* Visually hidden utility */
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">

  <a href="#main-content" class="skip-link">Skip to content</a>

  {%- unless template.name == 'index' or template.name == 'product' or template.suffix == 'settings' or template.suffix == 'credits' -%}
    {% section 'header' %}
  {%- endunless -%}

  <main id="main-content" class="main-content">
    {{ content_for_layout }}
  </main>

  {%- unless template.name == 'index' or template.name == 'product' or template.suffix == 'settings' or template.suffix == 'credits' -%}
    {% section 'footer' %}
  {%- endunless -%}

  {% render 'cart-drawer' %}
  {% render 'film-grain' %}
  {% render 'ember-particles' %}

  <script src="{{ 'cart.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
