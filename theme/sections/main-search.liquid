<div class="container search-page">
  <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
    <input class="search-page__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search..." aria-label="Search">
    <button type="submit" class="search-page__submit">Search</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="search-page__grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item, index: forloop.index0 %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="search-page__no-results">No results for &ldquo;{{ search.terms }}&rdquo;</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": []
}
{% endschema %}
