<div class="container list-collections">
  <div style="text-align:center;margin-bottom:3rem">
    <p style="font-family:var(--font-medieval);font-size:9px;letter-spacing:0.5em;text-transform:uppercase;color:rgba(255,255,255,0.2);margin-bottom:0.75rem">Obliveyon</p>
    <h1 style="font-family:var(--font-gothic);font-size:clamp(1.5rem,3vw,2rem);font-weight:300;letter-spacing:0.25em;text-transform:uppercase">Collections</h1>
  </div>

  <div class="list-collections__grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="collection-card">
        {%- if collection.image -%}
          <img class="collection-card__img" src="{{ collection.image | image_url: width: 800 }}" alt="{{ collection.image.alt | escape }}" loading="lazy">
        {%- else -%}
          <div style="width:100%;height:100%;background:rgba(255,255,255,0.03)"></div>
        {%- endif -%}
        <div class="collection-card__overlay">
          <span class="collection-card__name">{{ collection.title }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections List",
  "settings": []
}
{% endschema %}
