<div class="newsletter">
  <p class="newsletter__label">Stay Connected</p>
  <p class="newsletter__desc">Early access to drops, exclusive pieces, and news from the void.</p>

  {%- form 'customer', id: 'newsletter-form', data-newsletter-form: '' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter__form">
      <input
        class="newsletter__input"
        type="email"
        name="contact[email]"
        id="newsletter-email"
        placeholder="Enter your email"
        required
        aria-label="Email address"
      >
      <button type="submit" class="newsletter__submit">Join</button>
    </div>
    {%- if form.posted_successfully? -%}
      <p class="newsletter__message is-visible">Welcome to the void.</p>
    {%- endif -%}
    {%- if form.errors -%}
      <p class="newsletter__message is-visible is-error">{{ form.errors | default_errors }}</p>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
