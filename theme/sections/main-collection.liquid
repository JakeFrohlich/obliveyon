{% render 'cart-icon' %}

<div class="collection-page">
  <div class="collection-page__header container">
    <a href="{{ routes.root_url }}" class="collection-page__breadcrumb">&#8592; Return</a>

    <div class="collection-page__title-group">
      <p class="collection-page__subtitle">Obliveyon</p>
      <h1 class="collection-page__title">{{ collection.title | default: 'Collection' }}</h1>
    </div>

    <div class="collection-page__rule"></div>

    <div class="collection-page__filter-row">
      <p class="collection-page__filter-active">All</p>
    </div>
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-page__grid-wrap container">
      <div class="collection-page__grid">

        {%- for product in collection.products -%}
          {% render 'product-card', product: product, index: forloop.index0 %}
        {%- else -%}
          {%- for i in (1..10) -%}
            <div class="product-card--empty">
              {% render 'ornate-border', variant: 'card' %}
            </div>
          {%- endfor -%}
        {%- endfor -%}

        {%- comment -%}Empty slot placeholders to fill last row to 5 columns{%- endcomment -%}
        {%- assign product_count = collection.products_count -%}
        {%- if product_count > 0 -%}
          {%- assign remainder = product_count | modulo: 5 -%}
          {%- if remainder > 0 -%}
            {%- assign empty_count = 5 | minus: remainder -%}
            {%- for i in (1..empty_count) -%}
              <div class="product-card--empty">
                {% render 'ornate-border', variant: 'card' %}
              </div>
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%}Second row of empty slots if grid has fewer than 10 total items{%- endcomment -%}
          {%- if product_count < 6 -%}
            {%- assign second_row_count = 5 -%}
            <div class="collection-page__divider" style="grid-column:1/-1"></div>
            {%- for i in (1..second_row_count) -%}
              <div class="product-card--empty">
                {% render 'ornate-border', variant: 'card' %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}

      </div>

      {%- if paginate.pages > 1 -%}
        <div class="collection-page__pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 20
    }
  ]
}
{% endschema %}
