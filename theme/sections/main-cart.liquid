<div class="container cart-page">
  <h1 class="cart-page__title">Cart</h1>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      {%- for item in cart.items -%}
        <div class="cart-page__item">
          {%- if item.image -%}
            <img class="cart-page__item-img" src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" loading="lazy">
          {%- endif -%}
          <div style="flex:1;min-width:0">
            <p class="cart-page__item-name">{{ item.product.title }}</p>
            {%- if item.variant.title != 'Default Title' -%}
              <p class="cart-page__item-variant">{{ item.variant.title }}</p>
            {%- endif -%}
            <p class="cart-page__item-price">{{ item.final_line_price | money }}</p>
            <div class="cart-page__qty-selector" data-qty-selector data-line-key="{{ item.key }}">
              <button type="button" class="cart-page__qty-btn" data-qty-minus aria-label="Decrease">&minus;</button>
              <input class="cart-page__qty-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-qty-input aria-label="Quantity">
              <button type="button" class="cart-page__qty-btn" data-qty-plus aria-label="Increase">+</button>
            </div>
          </div>
          <button type="button" class="cart-page__remove-btn" data-cart-page-remove="{{ item.key }}">Remove</button>
        </div>
      {%- endfor -%}

      <div class="cart-page__summary">
        <div class="cart-page__summary-row">
          <span class="cart-page__summary-label">Subtotal</span>
          <span class="cart-page__summary-value">{{ cart.total_price | money }}</span>
        </div>
        <a href="/checkout" class="cart-page__checkout-btn">Proceed to Checkout</a>
      </div>
    {%- endform -%}
  {%- else -%}
    <div class="cart-page__empty">
      <p>Your cart is empty</p>
      <a href="{{ routes.collections_url }}" style="margin-top:1.5rem;display:inline-block;font-family:var(--font-medieval);font-size:10px;letter-spacing:0.4em;text-transform:uppercase;color:rgba(255,255,255,0.35);border-bottom:1px solid rgba(255,255,255,0.15);padding-bottom:0.25rem">Continue Shopping</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
