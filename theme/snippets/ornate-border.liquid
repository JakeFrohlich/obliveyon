{% comment %}
  Renders an SVG ornate border overlay.

  Usage:
    {% render 'ornate-border', variant: 'large' %}

  Variants:
    large   — full medieval hero button frame (sword cross, side diamonds, filigree)
    small   — secondary button frame (L-corner accents with circles)
    medium  — product image frame corners (subtle, 8-unit inset)
    card    — product card corners (faint, 12-unit inset with center diamonds)
    panel   — info panel corner accents (very subtle, 6-unit)
{% endcomment %}

{%- assign border_variant = variant | default: 'card' -%}

{%- if border_variant == 'large' -%}
  <svg class="hero-btn--primary__svg" viewBox="0 0 340 80" preserveAspectRatio="none" style="overflow:visible" aria-hidden="true">
    <defs><filter id="glow-main"><feGaussianBlur stdDeviation="2" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <g filter="url(#glow-main)">
      <rect x="1" y="1" width="338" height="78" rx="0" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="0.8"/>
      <!-- TL -->
      <line x1="-5" y1="0" x2="36" y2="0" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <line x1="0" y1="-5" x2="0" y2="28" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <!-- TR -->
      <line x1="345" y1="0" x2="304" y2="0" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <line x1="340" y1="-5" x2="340" y2="28" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <!-- BL -->
      <line x1="-5" y1="80" x2="36" y2="80" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <line x1="0" y1="85" x2="0" y2="52" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <!-- BR -->
      <line x1="345" y1="80" x2="304" y2="80" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <line x1="340" y1="85" x2="340" y2="52" stroke="rgba(255,255,255,0.8)" stroke-width="1.5"/>
      <!-- Top cross -->
      <line x1="170" y1="-9" x2="170" y2="9" stroke="rgba(255,255,255,0.65)" stroke-width="1"/>
      <line x1="162" y1="0" x2="178" y2="0" stroke="rgba(255,255,255,0.55)" stroke-width="1"/>
      <circle cx="170" cy="0" r="2.5" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="0.6"/>
      <!-- Bottom cross -->
      <line x1="170" y1="71" x2="170" y2="89" stroke="rgba(255,255,255,0.65)" stroke-width="1"/>
      <line x1="162" y1="80" x2="178" y2="80" stroke="rgba(255,255,255,0.55)" stroke-width="1"/>
      <circle cx="170" cy="80" r="2.5" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="0.6"/>
      <!-- Side diamonds -->
      <polygon points="-7,40 -3,36 1,40 -3,44" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.7"/>
      <polygon points="347,40 343,36 339,40 343,44" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="0.7"/>
    </g>
  </svg>

{%- elsif border_variant == 'small' -%}
  <svg class="hero-btn--secondary__svg" viewBox="0 0 220 48" preserveAspectRatio="none" aria-hidden="true">
    <defs><filter id="glow-sm"><feGaussianBlur stdDeviation="1" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <g filter="url(#glow-sm)">
      <!-- TL -->
      <line x1="0" y1="1" x2="22" y2="1" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <line x1="1" y1="0" x2="1" y2="15" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <circle cx="1" cy="1" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
      <!-- TR -->
      <line x1="220" y1="1" x2="198" y2="1" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <line x1="219" y1="0" x2="219" y2="15" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <circle cx="219" cy="1" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
      <!-- BL -->
      <line x1="0" y1="47" x2="22" y2="47" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <line x1="1" y1="48" x2="1" y2="33" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <circle cx="1" cy="47" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
      <!-- BR -->
      <line x1="220" y1="47" x2="198" y2="47" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <line x1="219" y1="48" x2="219" y2="33" stroke="rgba(255,255,255,0.42)" stroke-width="0.8"/>
      <circle cx="219" cy="47" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
    </g>
  </svg>

{%- elsif border_variant == 'card' -%}
  <svg class="product-card__corner-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <!-- TL -->
    <line x1="0" y1="0" x2="12" y2="0" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <line x1="0" y1="0" x2="0" y2="12" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <!-- TR -->
    <line x1="100" y1="0" x2="88" y2="0" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <line x1="100" y1="0" x2="100" y2="12" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <!-- BL -->
    <line x1="0" y1="100" x2="12" y2="100" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <line x1="0" y1="100" x2="0" y2="88" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <!-- BR -->
    <line x1="100" y1="100" x2="88" y2="100" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <line x1="100" y1="100" x2="100" y2="88" stroke="rgba(255,255,255,0.3)" stroke-width="0.5"/>
    <!-- Center top/bottom diamonds -->
    <polygon points="50,2 52,4 50,6 48,4" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="0.3"/>
    <polygon points="50,94 52,96 50,98 48,96" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="0.3"/>
  </svg>

{%- elsif border_variant == 'panel' -%}
  <svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <!-- TL -->
    <line x1="0" y1="0" x2="6" y2="0" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
    <line x1="0" y1="0" x2="0" y2="6" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
    <!-- TR -->
    <line x1="100" y1="0" x2="94" y2="0" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
    <line x1="100" y1="0" x2="100" y2="6" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
    <!-- BL -->
    <line x1="0" y1="100" x2="6" y2="100" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
    <line x1="0" y1="100" x2="0" y2="94" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
    <!-- BR -->
    <line x1="100" y1="100" x2="94" y2="100" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
    <line x1="100" y1="100" x2="100" y2="94" stroke="rgba(255,255,255,0.15)" stroke-width="0.4"/>
  </svg>

{%- else -%}
  {%- comment -%}medium — product image frame corners{%- endcomment -%}
  <svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <!-- TL -->
    <line x1="0" y1="0" x2="8" y2="0" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
    <line x1="0" y1="0" x2="0" y2="8" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
    <!-- TR -->
    <line x1="100" y1="0" x2="92" y2="0" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
    <line x1="100" y1="0" x2="100" y2="8" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
    <!-- BL -->
    <line x1="0" y1="100" x2="8" y2="100" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
    <line x1="0" y1="100" x2="0" y2="92" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
    <!-- BR -->
    <line x1="100" y1="100" x2="92" y2="100" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
    <line x1="100" y1="100" x2="100" y2="92" stroke="rgba(255,255,255,0.28)" stroke-width="0.4"/>
  </svg>
{%- endif -%}
