{% comment %}
  Renders an ornate bordered button with SVG corner/frame accents.

  Usage:
    {% render 'ornate-button', label: 'Press Play', url: '/collections/all', size: 'large' %}

  Parameters:
    label  — button text (required)
    url    — href link (required)
    size   — 'large' | 'small' (default: 'small')
{% endcomment %}

{%- assign btn_size = size | default: 'small' -%}

<a href="{{ url }}" class="ornate-btn ornate-btn--{{ btn_size }}">
  {%- if btn_size == 'large' -%}
    <svg class="ornate-btn__svg" viewBox="0 0 360 76" preserveAspectRatio="none" style="overflow:visible" aria-hidden="true">
      <defs>
        <filter id="ornate-glow-lg">
          <feGaussianBlur stdDeviation="2" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <g filter="url(#ornate-glow-lg)">
        <rect x="1" y="1" width="358" height="74" fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="0.7"/>
        <!-- TL -->
        <line x1="-5" y1="0" x2="36" y2="0" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <line x1="0" y1="-5" x2="0" y2="28" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <!-- TR -->
        <line x1="365" y1="0" x2="324" y2="0" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <line x1="360" y1="-5" x2="360" y2="28" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <!-- BL -->
        <line x1="-5" y1="76" x2="36" y2="76" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <line x1="0" y1="81" x2="0" y2="48" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <!-- BR -->
        <line x1="365" y1="76" x2="324" y2="76" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <line x1="360" y1="81" x2="360" y2="48" stroke="rgba(255,255,255,0.75)" stroke-width="1.4"/>
        <!-- Top sword cross -->
        <line x1="180" y1="-12" x2="180" y2="6" stroke="rgba(255,255,255,0.6)" stroke-width="0.9"/>
        <line x1="174" y1="-3" x2="186" y2="-3" stroke="rgba(255,255,255,0.5)" stroke-width="0.9"/>
        <polygon points="180,-10 182,-6 180,-2 178,-6" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="0.6"/>
        <!-- Bottom sword cross -->
        <line x1="180" y1="88" x2="180" y2="70" stroke="rgba(255,255,255,0.6)" stroke-width="0.9"/>
        <line x1="174" y1="79" x2="186" y2="79" stroke="rgba(255,255,255,0.5)" stroke-width="0.9"/>
        <polygon points="180,86 182,82 180,78 178,82" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="0.6"/>
        <!-- Side diamonds -->
        <polygon points="-6,38 -2,34 2,38 -2,42" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="0.7"/>
        <polygon points="366,38 362,34 358,38 362,42" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="0.7"/>
        <!-- Horizontal filigree -->
        <line x1="150" y1="0" x2="170" y2="0" stroke="rgba(255,255,255,0.18)" stroke-width="0.5"/>
        <line x1="190" y1="0" x2="210" y2="0" stroke="rgba(255,255,255,0.18)" stroke-width="0.5"/>
        <line x1="150" y1="76" x2="170" y2="76" stroke="rgba(255,255,255,0.18)" stroke-width="0.5"/>
        <line x1="190" y1="76" x2="210" y2="76" stroke="rgba(255,255,255,0.18)" stroke-width="0.5"/>
      </g>
    </svg>
  {%- else -%}
    <svg class="ornate-btn__svg" viewBox="0 0 230 48" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <filter id="ornate-glow-sm">
          <feGaussianBlur stdDeviation="1" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <g filter="url(#ornate-glow-sm)">
        <!-- TL -->
        <line x1="0" y1="1" x2="24" y2="1" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <line x1="1" y1="0" x2="1" y2="16" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <circle cx="1" cy="1" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
        <!-- TR -->
        <line x1="230" y1="1" x2="206" y2="1" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <line x1="229" y1="0" x2="229" y2="16" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <circle cx="229" cy="1" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
        <!-- BL -->
        <line x1="0" y1="47" x2="24" y2="47" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <line x1="1" y1="48" x2="1" y2="32" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <circle cx="1" cy="47" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
        <!-- BR -->
        <line x1="230" y1="47" x2="206" y2="47" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <line x1="229" y1="48" x2="229" y2="32" stroke="rgba(255,255,255,0.4)" stroke-width="0.8"/>
        <circle cx="229" cy="47" r="1.5" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5"/>
      </g>
    </svg>
  {%- endif -%}

  <span class="ornate-btn__text">{{ label }}</span>
</a>
